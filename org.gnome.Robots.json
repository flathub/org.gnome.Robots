{
    "app-id": "org.gnome.Robots",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "gnome-robots",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/rust-flatpak/cargo"
        },
        "test-args": [
            "--socket=x11"
        ]
    },
    "modules": [
        {
            "name": "gnome-robots",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/gnome-robots/50/gnome-robots-50.0.tar.xz",
                    "sha256": "617e574c15f90618b82493c9939d717596ad2ce1ff1de0aad5c9c3976633d379",
                    "x-checker-data": {
                        "type": "gnome",
                        "name": "gnome-robots"
                    }
                },
                "generated-sources.json",
                {
                    "type": "shell",
                    "commands": [
                        "mkdir .cargo",
                        "cp cargo/config .cargo/"
                    ]
                }
            ]
        }
    ]
}
